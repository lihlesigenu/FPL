(ict_index / 10) +
(expected_goals + expected_assists) * 2
)
players_df <- players_df %>%
mutate(
ict_index = as.numeric(ict_index),
price = now_cost / 10,
points_per_million = points_per_game/price,
value_score = points_per_million +
(ict_index / 10) +
(expected_goals + expected_assists) * 2
)
